{
  "name": "cloudflare-rag",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "deploy": "npm run build && wrangler pages deploy",
    "dev": "remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "wrangler pages dev ./build/client",
    "typecheck": "tsc",
    "typegen": "wrangler types",
    "preview": "npm run build && wrangler pages dev",
    "cf-typegen": "wrangler types",
    "migrate:local": "npx drizzle-kit generate && wrangler d1 migrations apply cloudflare-rag --local",
    "migrate": "npx drizzle-kit generate && wrangler d1 migrations apply cloudflare-rag --remote"
  },
  "dependencies": {
    "@cloudflare/ai-utils": "^1.0.1",
    "@langchain/core": "^1.2.14",
    "@langchain/textsplitters": "^1.0.2",
    "@napi-rs/canvas": "0.1.100",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@remix-run/cloudflare": "^2.17.5",
    "@remix-run/cloudflare-pages": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/typography": "^0.5.20",
    "ai": "^3.4.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "eventsource": "^2.0.2",
    "fetch-event-stream": "^0.1.6",
    "framer-motion": "^11.18.2",
    "isbot": "^4.4.0",
    "lucide-react": "^0.436.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.4.1",
    "react-dropzone-esm": "^15.2.0",
    "react-markdown": "^9.1.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "ulidx": "^2.4.1",
    "unpdf": "1.8.1",
    "vaul": "^0.9.9",
    "workers-ai-provider": "^0.0.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@remix-run/dev": "^2.17.5",
    "@types/eventsource": "^1.1.15",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "autoprefixer": "^10.4.27",
    "drizzle-kit": "0.31.11",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^4.3.2",
    "wrangler": "3.114.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
